# 复制为 env/.env 后填真实值
# 取值优先级：compose environment > env/.env > 代码默认
# 配置文件位置，默认 env/.env
# DEEPRESEARCHER_ENV_FILE=env/.env
#
# 最小可运行
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_ID              位置：01
#   TAVILY_API_KEY 或 BAIDU_API_KEY 或 SERPAPI_API_KEY     位置：03
# 推荐填写
#   
#   ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET 

# ---- 01 模型服务 ----
# 三项均必填，OpenAI 兼容接口
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
# 单次请求输出上限
LLM_MAX_COMPLETION_TOKENS=32768
# 需不小于上一项
LLM_CONTEXT_WINDOW_TOKENS=32768
# 结构化输出不合规时的修复次数
LLM_STRUCTURED_REPAIR_ATTEMPTS=2

# 按 agent 定制请求参数（JSON），键为 supervisor / researcher / writer / reviewer
# / router / quick_answer / clarifier。供应商私有开关放 extra_body，例如：
# {"researcher": {"extra_body": {"thinking": {"type": "disabled"}}}}
LLM_REQUEST_OVERRIDES=

# ---- 02 并发与花费 ----
# 全局并发上限，过高会触发供应商限流
LLM_MAX_CONCURRENT_REQUESTS=6
# 每进程每分钟请求数与 token 数，0 不限
LLM_PROVIDER_RPM=0
LLM_PROVIDER_TPM=0
# 预留输出 token，不占输入预算
LLM_PROVIDER_OUTPUT_TOKEN_RESERVE=1024
# 单次 run 的 token 上限，0 不限
LLM_MAX_TOKENS_PER_RUN=0
# 花费限制 0 表示不限，单位元
LLM_MAX_COST_CNY_PER_RUN=0
LLM_MAX_COST_CNY_PER_USER_DAILY=0
LLM_MAX_COST_CNY_PLATFORM_HOURLY=0
LLM_MAX_COST_CNY_PLATFORM_DAILY=0

# ---- 03 搜索服务 ----
# auto/baidu/tavily/serpapi/aliyun
# 填写 auto 后 按顺序选择可用，失败自动降级 
# 阿里云没有 API Key，填写 AccessKey 视为可用
SEARCH_PROVIDER=auto
# auto 时的尝试顺序
SEARCH_PROVIDER_PRIORITY=tavily,serpapi,aliyun,baidu
# 连续失败几次把该供应商移出候选池，首次冷却秒数（按被踢次数递增，五倍封顶）
SEARCH_PROVIDER_FAIL_THRESHOLD=3
SEARCH_PROVIDER_COOLDOWN_SECONDS=60
BAIDU_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
# 取回正文而非仅摘要
TAVILY_INCLUDE_RAW_CONTENT=False
# 单次查询返回条数
SEARCH_MAX_RESULTS=5
# 同一供应商的并发上限，按单个 worker 计
SEARCH_MAX_CONCURRENT_REQUESTS=5
SEARCH_TIMEOUT=20.0
SEARCH_RETRY_ATTEMPTS=3
SEARCH_RETRY_INITIAL_SECONDS=1.0
SEARCH_RETRY_MAX_SECONDS=10.0
# 响应带 Retry-After 时的最大等待，单位秒
SEARCH_RETRY_AFTER_MAX_SECONDS=60.0

# ---- 04 网页抓取 ----
# direct/aliyun，按序尝试
FETCH_PROVIDER_ORDER=direct
FETCH_MAX_CONCURRENT_REQUESTS=6
# 单页字节上限
FETCH_MAX_BYTES=25165824
# 留空直连，并忽略环境里的 HTTP(S)_PROXY
# FETCH_PROXY=

# 阿里云搜索/抓取服务，抓取成功概率更高
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIYUN_WEB_REGION_ID=cn-beijing
# ALIYUN_WEB_ENDPOINT=dtsai.cn-beijing.aliyuncs.com
# ALIYUN_WEB_AGENT_NAME=deepresearcher
# 阿里云 SDK 的出口代理。留空直连，并忽略环境里的 HTTP(S)_PROXY
# ALIYUN_WEB_PROXY=
# 抓取结果返回形式 
# ALIYUN_WEB_FETCH_OUTPUT_FORMAT=markdown

# 追加拦截的公网段，逗号分隔；私网与保留段已默认拦截，仅对 direct 抓取有效
SSRF_BLOCK_CIDRS="192.0.0.0/24,192.88.99.0/24,64:ff9b::/96"
# fake-IP 代理环境置 true，将关闭默认判据
SSRF_ALLOW_PRIVATE_ADDRESSES=false

# ---- 05 轮次与并行 ----
AGENT_MAX_RESEARCH_ROUNDS=2
# 每轮允许派发的子方向数
AGENT_MAX_TASKS_PER_ROUND=12
# Supervisor 同时运行的研究任务数，单实例内生效
AGENT_SUPERVISOR_MAX_CONCURRENT_TASKS=3
# 单个子方向的 turn 上限
AGENT_RESEARCH_MAX_TURNS=12
AGENT_RESEARCH_MAX_QUERIES=6
# 单个子方向同时读取的来源数
AGENT_RESEARCH_MAX_CONCURRENT_SOURCE_READS=3
# 单个来源的抓取、解析与整体超时，单位秒
AGENT_SOURCE_FETCH_TIMEOUT=30.0
AGENT_SOURCE_PARSE_TIMEOUT=20.0
AGENT_SOURCE_TOTAL_TIMEOUT=60.0

# ---- 06 证据池 ----
# 前两项不能大于候选池，越界则启动报错
AGENT_EVIDENCE_MAX_PER_SOURCE=4
AGENT_RESEARCH_MAX_EVIDENCES_PER_TASK=10
AGENT_RESEARCH_MAX_EVIDENCE_CANDIDATES_PER_TASK=40
# 写作时可引用的证据上限
AGENT_SUPERVISOR_MAX_ACTIVE_EVIDENCES=50
AGENT_EVIDENCE_ADD_BATCH_SIZE=8

# ---- 07 写作与审阅 ----
# Writer 的 turn 上限
AGENT_WRITER_MAX_TURNS=8
# 审阅次数上限，含首次
AGENT_MAX_REVIEW_ATTEMPTS=2
# 结构化收尾缺失时的纠正次数
AGENT_FINALIZATION_ATTEMPTS=2
# partial/strict,strict仅接受直接来源于网页
# partial 允许来自搜索结果的摘要
AGENT_WRITER_MINIMUM_SUPPORT=partial
# 报告最多列出的注意事项条数
AGENT_REPORT_MAX_CAVEATS=10
AGENT_OUTPUT_LANGUAGE=中文

# ---- 08 读料窗口 ----
# 短文内联进上下文的 token 上限
AGENT_DOCUMENT_INLINE_MAX_TOKENS=6000
# 单次工具调用的内联总量
AGENT_DOCUMENT_INLINE_TOTAL_MAX_TOKENS=12000
AGENT_DOCUMENT_READ_MAX_RANGES=6
AGENT_DOCUMENT_READ_MAX_LINES=240
AGENT_DOCUMENT_READ_MAX_CHARS=24000
# 检索命中时上下各带几行
AGENT_DOCUMENT_GREP_CONTEXT_LINES=2
AGENT_DOCUMENT_GREP_MAX_MATCHES=12
AGENT_DOCUMENT_GREP_MAX_CHARS=12000

# ---- 09 服务入口 ----
APP_ENV=development
# 直接运行进程时生效；容器内由 compose 覆盖
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
# 生产必填，≥32 字符；开发环境留空则每次启动重新生成
SERVICE_JWT_SECRET=
SERVICE_TOKEN_TTL_HOURS=12
# 仅信任本机反代，勿填 *
SERVICE_FORWARDED_ALLOW_IPS=127.0.0.1

# ---- 10 并发与排队 ----
SERVICE_MAX_CONCURRENT_RUNS_PER_USER=2
# 单 worker 并行执行数，超出排队
SERVICE_WORKER_MAX_RUNNING_RUNS=5
SERVICE_MAX_GLOBAL_QUEUED_RUNS=100
SERVICE_WORKER_LEASE_CHECK_SECONDS=15

# ---- 11 登录限流 ----
SERVICE_LOGIN_ACCOUNT_ATTEMPTS=5
SERVICE_LOGIN_IP_ATTEMPTS=20
SERVICE_LOGIN_RATE_WINDOW_SECONDS=300
# 锁定时长，单位秒
SERVICE_LOGIN_BLOCK_SECONDS=900

# ---- 12 PostgreSQL ----
# 必须是 postgresql+asyncpg://，服务依赖 advisory lock 与 LISTEN/NOTIFY
SERVICE_DATABASE_URL=postgresql+asyncpg://deepsearch:deepsearch@localhost:5432/deepsearch

# ---- 13 Redis ----
SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
SERVICE_MATERIAL_REDIS_URL=redis://127.0.0.1:6379/0
SERVICE_REDIS_CHANNEL_PREFIX=deepresearcher
# 预览帧的队列长度
SERVICE_REDIS_PREVIEW_QUEUE_SIZE=128
SERVICE_MATERIAL_KEY_PREFIX=deepresearcher:material
# 搜索与文档素材的缓存有效期，单位秒
SERVICE_SEARCH_MATERIAL_TTL_SECONDS=21600
SERVICE_DOCUMENT_MATERIAL_TTL_SECONDS=86400

# ---- 14 RocketMQ ----
# 接入点端口，非 9876
SERVICE_ROCKETMQ_ENDPOINTS=127.0.0.1:8081
# 托管实例填，自建留空
SERVICE_ROCKETMQ_ACCESS_KEY=
SERVICE_ROCKETMQ_ACCESS_SECRET=
SERVICE_ROCKETMQ_NAMESPACE=
SERVICE_ROCKETMQ_DISPATCH_TOPIC=run_dispatch
# 手动补发走独立 topic
SERVICE_ROCKETMQ_REDISPATCH_TOPIC=run_redispatch
# 所有 worker 共用，必须一致
SERVICE_ROCKETMQ_CONSUMER_GROUP=deepresearcher-worker
# 可见性时长，超时后转交其他消费者
SERVICE_ROCKETMQ_INVISIBLE_SECONDS=90
# 不超过可见性时长的 1/3
SERVICE_ROCKETMQ_VISIBILITY_RENEW_SECONDS=30
# 必须小于 17，否则触不到死信
SERVICE_ROCKETMQ_DISPATCH_MAX_ATTEMPTS=15
SERVICE_ROCKETMQ_AWAIT_DURATION_SECONDS=2
SERVICE_ROCKETMQ_PULL_FANOUT=16

# ---- 15 保留与清理 ----
SERVICE_LOG_DIR=var/service
SERVICE_JSONL_EVENTS=true
SERVICE_JSONL_RETENTION_DAYS=14
# 终态 run 的过程数据保留天数，0 关闭清扫
SERVICE_RUN_TRACE_RETENTION_DAYS=14
SERVICE_RETENTION_SWEEP_INTERVAL_SECONDS=21600

# ---- 16 日志与观测 ----
LOG_LEVEL=INFO
# 默认 var/logs
# OBSERVABILITY_LOG_DIR=
OBSERVABILITY_LOG_FILE=agent.log
OBSERVABILITY_EVENT_FILE=events.jsonl
OBSERVABILITY_TRACE_FILE=traces.jsonl
# 单个字段写入日志的最大字符数
OBSERVABILITY_MAX_TEXT_CHARS=1000
# 三项齐全才启用 Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# none/console
# SERVICE_OTEL_EXPORTER=none

# 复制本文件为 env/.env 并填入真实值（env/.env 已被 git 忽略）。
# 加载方式：src/deepresearcher/config.py 与 service/settings.py 启动时读取
# （可用 DEEPRESEARCHER_ENV_FILE 覆盖路径）。

# ---- LLM（引擎） ----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_ID=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0

# ---- 搜索/抓取（引擎） ----
SEARCH_PROVIDER=auto
BAIDU_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
# 阿里云 DTS AI 使用官方默认凭据链；本地可通过
# ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET 提供凭据。
# SEARCH_PROVIDER=aliyun
# FETCH_PROVIDER_ORDER=aliyun,direct
ALIYUN_DTS_REGION_ID=cn-beijing
ALIYUN_DTS_ENDPOINT=dtsai.cn-beijing.aliyuncs.com
ALIYUN_DTS_AGENT_NAME=deepresearcher
ALIYUN_DTS_FETCH_OUTPUT_FORMAT=markdown
SEARCH_MAX_RESULTS=5
SEARCH_MAX_CONCURRENT_REQUESTS=2
SEARCH_RETRY_AFTER_MAX_SECONDS=60.0

# ---- 研究预算（引擎） ----
AGENT_FINALIZATION_ATTEMPTS=2
AGENT_MAX_RESEARCH_ROUNDS=2
AGENT_RESEARCH_MAX_TURNS=5
AGENT_RESEARCH_MAX_EVIDENCES_PER_DIRECTION=6
AGENT_RESEARCH_MAX_EVIDENCE_CANDIDATES_PER_DIRECTION=12
AGENT_SUPERVISOR_MAX_ACTIVE_EVIDENCES=30
AGENT_WRITER_MINIMUM_SUPPORT=partial
AGENT_PARTIAL_REPORT_MIN_EVIDENCES=5
AGENT_PARTIAL_REPORT_MIN_SOURCES=5

# ---- 观测（引擎） ----
# OBSERVABILITY_LOG_DIR=  # 默认 var/logs
LOG_LEVEL=INFO

# ---- 服务层（service） ----
# docker compose up -d 后的本地默认值：
SERVICE_DATABASE_URL=postgresql+asyncpg://deepsearch:deepsearch@localhost:5432/deepsearch
# 必填（生产）：≥32 字符。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_JWT_SECRET=
SERVICE_TOKEN_TTL_HOURS=12
SERVICE_MAX_CONCURRENT_RUNS_PER_USER=2
SERVICE_MAX_GLOBAL_RUNNING_RUNS=3
SERVICE_MAX_GLOBAL_QUEUED_RUNS=100
SERVICE_WORKER_LEASE_SECONDS=60
SERVICE_WORKER_HEARTBEAT_SECONDS=20
# API 默认只做控制面；本地单进程开发可改为 true。
SERVICE_API_EMBEDDED_WORKER=false
SERVICE_WORKER_POLL_SECONDS=1.0
# 只承载可丢弃的跨进程 text_delta；不作为 Run/Event 事实源。
SERVICE_REDIS_PREVIEW_ENABLED=false
SERVICE_REDIS_URL=redis://127.0.0.1:6379/0
SERVICE_REDIS_CHANNEL_PREFIX=deepresearcher
SERVICE_REDIS_PREVIEW_QUEUE_SIZE=128
# 登录限流：同一账号/IP 在窗口内允许的尝试数，超限后进入阻断期。
SERVICE_LOGIN_ACCOUNT_ATTEMPTS=5
SERVICE_LOGIN_IP_ATTEMPTS=20
SERVICE_LOGIN_RATE_WINDOW_SECONDS=300
SERVICE_LOGIN_BLOCK_SECONDS=900
# 只信任来自本机反向代理的 X-Forwarded-*；不要在公网监听时设为 *。
SERVICE_FORWARDED_ALLOW_IPS=127.0.0.1
LLM_MAX_CONCURRENT_REQUESTS=6
# Provider 的每 Worker 速率闸；0 表示不在本地限制。
LLM_PROVIDER_RPM=0
LLM_PROVIDER_TPM=0
LLM_PROVIDER_OUTPUT_TOKEN_RESERVE=1024
# 0 表示不限制；在每次新的 LLM 请求前检查。
LLM_MAX_TOKENS_PER_RUN=0
LLM_MAX_COST_USD_PER_RUN=0
LLM_MAX_COST_USD_PER_USER_DAILY=0
LLM_MAX_COST_USD_PLATFORM_HOURLY=0
LLM_MAX_COST_USD_PLATFORM_DAILY=0
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_CACHED_INPUT_USD_PER_MILLION=0
LLM_PRICE_VERSION=unpriced
FETCH_MAX_CONCURRENT_REQUESTS=6
TOOL_CACHE_ENABLED=true
TOOL_CACHE_SEARCH_TTL_SECONDS=21600
TOOL_CACHE_FETCH_TTL_SECONDS=86400
TOOL_CACHE_EVIDENCE_TTL_SECONDS=604800
# 对应实现变更时升版，旧缓存会自然 miss。
TOOL_CACHE_SEARCH_VERSION=search-v1
TOOL_CACHE_FETCH_POLICY_VERSION=public-fetch-v1
TOOL_CACHE_PARSER_VERSION=parser-v1
TOOL_CACHE_EXTRACTOR_PROMPT_VERSION=evidence-prompt-v1
TOOL_CACHE_EVIDENCE_SCHEMA_VERSION=evidence-schema-v1
TOOL_CACHE_CHUNKING_VERSION=chunks-v1
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
# SERVICE_LOG_DIR=        # 默认 var/service
# SERVICE_JSONL_EVENTS=true

# ---- 部署环境 ----
APP_ENV=development

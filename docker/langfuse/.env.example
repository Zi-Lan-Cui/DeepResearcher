# Langfuse 自托管演示栈环境模板:复制为同目录 .env 后按注释填充(.env 被 .gitignore 覆盖,本模板不含可用密钥)。
# 密钥生成:openssl rand -hex <字节数>;ENCRYPTION_KEY 必须为 32 字节(64 位十六进制)。

SALT=<openssl rand -hex 16>
NEXTAUTH_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>
POSTGRES_PASSWORD=<openssl rand -hex 16>
CLICKHOUSE_PASSWORD=<openssl rand -hex 16>
REDIS_AUTH=<openssl rand -hex 16>
MINIO_ROOT_PASSWORD=<openssl rand -hex 16>

# 首启自动置备(本地演示;生产请换掉账号与键)。
LANGFUSE_INIT_USER_EMAIL=demo@local.dev
LANGFUSE_INIT_USER_NAME=demo
LANGFUSE_INIT_USER_PASSWORD=<openssl rand -hex 16>
LANGFUSE_INIT_ORG_ID=deepresearcher
LANGFUSE_INIT_ORG_NAME=DeepResearcher
LANGFUSE_INIT_PROJECT_ID=deepresearcher-demo
LANGFUSE_INIT_PROJECT_NAME=deepresearcher-demo
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-demo-<openssl rand -hex 16>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-demo-<openssl rand -hex 16>
NEXTAUTH_URL=http://localhost:3000

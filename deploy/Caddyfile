# Public TLS terminates here; Uvicorn remains bound to loopback by default.
# Set DEEPSEARCH_SITE_ADDRESS to a DNS name that resolves to this host.
{$DEEPSEARCH_SITE_ADDRESS:localhost} {
	reverse_proxy {$DEEPSEARCH_UPSTREAM:127.0.0.1:8080} {
		# Keep SSE/token previews interactive instead of batching proxy output.
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
